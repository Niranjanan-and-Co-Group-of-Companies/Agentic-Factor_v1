{
  "expo": {
    "name": "Agentic Factor",
    "slug": "agentic-factor",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "agenticfactor",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "io.agenticfactor.app",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "io.agenticfactor.app",
      "adaptiveIcon": {
        "backgroundColor": "#F7F3EC",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F3EC",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#131210",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      "expo-apple-authentication",
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": "Agentic Factor uses the microphone so you can talk to your assistant instead of typing.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "cc0f095c-b8bb-4777-9d77-5dfd6025bc5e"
      }
    },
    "owner": "agenticfactors-team"
  }
}
