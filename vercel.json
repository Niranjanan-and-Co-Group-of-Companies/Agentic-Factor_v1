{
  "regions": [
    "bom1"
  ],
  "crons": [
    {
      "path": "/api/cron/scheduler",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/health-check",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/mission-watchdog",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/ads-governor",
      "schedule": "30 1 * * *"
    },
    {
      "path": "/api/cron/cost-check",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/account-deletions",
      "schedule": "0 3 * * *"
    }
  ],
  "ignoreCommand": "[ \"$VERCEL_GIT_PREVIOUS_SHA\" != \"$VERCEL_GIT_COMMIT_SHA\" ] && git diff --quiet ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^} HEAD -- . ':(exclude)mobile'"
}
